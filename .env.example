# Letter Draft Assistant — Optional Environment Configuration
# Copy to .env or set as host environment variables when deploying to cloud/Docker.

PORT=3000
HOST=0.0.0.0
SESSION_TTL_HOURS=12

# Optional: Auto-create Initial Admin on first boot (if omitted, web UI shows First-Time Setup Wizard)
# ADMIN_USERNAME=principal
# ADMIN_DISPLAY_NAME=Mrs. Sumita Tudu (Principal)
# ADMIN_PASSWORD=ReplaceWithStrongPassword#2026

# Optional: Google Apps Script Web App URL for automatic Google Sheets Register Sync
# GSHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# GSHEET_WEBHOOK_SECRET=your_optional_secret
